# ==============================================================================
# SentinelAI — Production Environment Variables
# ==============================================================================
# Copy this file to .env.prod on your production VM before running docker compose.
# Command: cp .env.production.example .env.prod

# ─── Environment & Domain ─────────────────────────────────────────────────────
ENVIRONMENT=production
DOMAIN_NAME=yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# ─── PostgreSQL Database ──────────────────────────────────────────────────────
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=generate_a_random_32char_password_here
POSTGRES_DB=sentinelai
DATABASE_URL=postgresql://sentinel:generate_a_random_32char_password_here@postgres:5432/sentinelai

# ─── Authentication & Security ────────────────────────────────────────────────
# Generate a secret: openssl rand -hex 32
JWT_SECRET_KEY=generate_a_random_64char_hex_secret_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Point to your production domain (comma-separated if using multiple)
CORS_ORIGINS=https://yourdomain.com,http://yourdomain.com

# ─── Frontend Build Argument ──────────────────────────────────────────────────
# In production reverse-proxy mode, the frontend calls the same origin or your domain
NEXT_PUBLIC_API_URL=https://yourdomain.com

# ─── Vision & Storage Settings ────────────────────────────────────────────────
VIDEO_STORAGE_PATH=/app/storage
MAX_VIDEO_SIZE_MB=250
SAMPLE_INTERVAL_SECONDS=2.0
YOLO_MODEL=yolo11n.pt
TRACKING_ENABLED=true

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_AI_PER_MINUTE=30

# ─── AI Incident Reporting ────────────────────────────────────────────────────
# Options: "gemini" | "groq" | "mock"
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
