# ==============================================================================
# SentinelAI Backend — Environment Configuration Example
# ==============================================================================
# Copy this file to backend/.env for local overrides.
# NEVER commit real backend/.env to version control.

# --- Environment ---
# Options: development | production | testing
ENVIRONMENT=development

# --- Database ---
# PostgreSQL (production / staging):
# DATABASE_URL=postgresql://sentinel:password@localhost:5432/sentinelai
#
# SQLite (local development — zero config required):
DATABASE_URL=sqlite:///./sentinel.db

# --- JWT Authentication ---
# In production, this must be >= 32 random characters.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins (no wildcard '*' in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Rate Limiting (Phase 10) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=20

# --- Video Processing & Storage (Phase 3) ---
VIDEO_STORAGE_PATH=./storage
MAX_VIDEO_SIZE_MB=250
SAMPLE_INTERVAL_SECONDS=2
MAX_FRAME_WIDTH=1280
THUMBNAIL_WIDTH=320

# --- YOLO Object Detection (Phase 4) ---
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE_THRESHOLD=0.50
YOLO_ALLOWED_CLASSES=person,car,motorcycle,bus,truck,bicycle
YOLO_DEVICE=auto

# --- Object Tracking & Temporal Intelligence (Phase 5) ---
TRACKING_ENABLED=true
TRACKER_TYPE=bytetrack
TRACK_HIGH_CONFIDENCE_THRESHOLD=0.25
TRACK_LOW_CONFIDENCE_THRESHOLD=0.10
TRACK_BUFFER_FRAMES=30
TRACK_MATCH_THRESHOLD=0.80
TRACK_DRAW_TRAJECTORY=true
TRACK_MAX_TRAJECTORY_POINTS=30

# --- Real-Time Monitoring & WebSocket (Phase 7) ---
REALTIME_ENABLED=true
WEBSOCKET_ENABLED=true
REALTIME_HEARTBEAT_INTERVAL=5
REALTIME_RECONNECT_MAX_SECONDS=30

# --- AI Incident Intelligence (Phase 8) ---
# Options: "gemini" | "groq" | "mock"
# Automatically falls back to "mock" if selected provider key is empty.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_REQUEST_TIMEOUT_SECONDS=30
