# ==============================================================================
# SentinelAI — Global Environment Configuration Example
# ==============================================================================
# Copy relevant sections to backend/.env and frontend/.env.local
# DO NOT commit real production secrets to version control.

# ─── Environment ─────────────────────────────────────────────────────────────
# Options: development | production | testing
ENVIRONMENT=development

# ─── Backend Settings ────────────────────────────────────────────────────────
# PostgreSQL (production):
# DATABASE_URL=postgresql://sentinel:your_secure_password@localhost:5432/sentinelai
# SQLite (development default):
DATABASE_URL=sqlite:///./sentinel.db

# JWT Secret (Must be 32+ characters in production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Allowed CORS Origins (comma-separated, NO wildcard '*' in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_AI_PER_MINUTE=20

# AI Provider ("gemini" | "groq" | "mock")
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ─── Frontend Settings ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
